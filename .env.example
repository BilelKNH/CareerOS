# ---- Database ----
DATABASE_URL="postgresql://careeros:careeros@localhost:5432/careeros?schema=public"

# ---- Redis (BullMQ) ----
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ---- Auth ----
JWT_SECRET="change-me-please-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-too-another-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- API ----
API_PORT="3001"
WEB_ORIGIN="http://localhost:3000"

# ---- AI providers ----
# LLM (reasoning agents) — Anthropic
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-4-5"
# Embeddings — LOCAL par défaut : hashing pur-JS (gratuit, offline, 0 dépendance, 384 dims).
# Similarité lexicale (recoupement de termes). Aucun modèle ni binaire à installer.
EMBEDDING_PROVIDER="local"
EMBEDDING_DIMENSIONS="384"
# Pour utiliser OpenAI à la place : EMBEDDING_PROVIDER="openai", renseigne la clé,
# et passe le schéma pgvector en vector(1536).
OPENAI_API_KEY=""

# ---- Job sources ----
# France Travail (ex Pôle emploi) — API officielle "Offres d'emploi v2".
# Crée une appli sur https://francetravail.io pour obtenir ces identifiants.
# Laisse vide pour utiliser la source échantillon (offline).
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""

# Adzuna — agrégateur multi-sources (API conforme). Clés gratuites :
# https://developer.adzuna.com/  (crée une app -> app_id + app_key)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ---- Email (canal d'auto-candidature) ----
# Resend (https://resend.com) — requis pour l'envoi automatique par email.
# Sans ces variables, le canal email échoue proprement (jamais d'envoi silencieux).
RESEND_API_KEY=""
EMAIL_FROM="Bilel <bilel@ton-domaine.fr>"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
