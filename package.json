{
  "name": "careeros",
  "private": true,
  "version": "0.1.0",
  "description": "CareerOS — assistant de carrière intelligent à mémoire persistante",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:turbo": "turbo run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @careeros/database generate",
    "db:migrate": "pnpm --filter @careeros/database migrate",
    "db:seed": "pnpm --filter @careeros/database seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
